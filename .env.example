# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://pxhaafmzfawajginidos.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_FtfMVz8g3DSzBa3jQnhgVg_92XJMpNS
# 대시보드 → Settings → API → secret key (서버 전용, 절대 NEXT_PUBLIC 금지)
SUPABASE_SECRET_KEY=

# ── 세션 (openssl rand -hex 32) ──
AUTH_SECRET=

# ── 어드민 부트스트랩 (쉼표 구분 이메일; DB users.role과 듀얼 소스) ──
ADMIN_EMAILS=culture@culturing.org

# ── 지갑/소셜 ──
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── SIWE ──
NEXT_PUBLIC_APP_DOMAIN=localhost:3000

# ── RPC URLs (WS2 backend) ──
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
POLYGON_RPC_URL=https://polygon-rpc.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY

# ── Cron (Vercel cron auth) ──
CRON_SECRET=random-secret-for-cron-auth

# ── Encryption (AES-256-GCM, 32 bytes hex = 64 chars) ──
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Contract deployment (WS1) ──
DEPLOYER_PRIVATE_KEY=0xabc...
FEE_RECIPIENT=0x...

# ── Etherscan verify ──
ETHERSCAN_API_KEY=ABC...
POLYGONSCAN_API_KEY=ABC...

# ── Telegram alerts (optional) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
