# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Contract addresses
NEXT_PUBLIC_POOL_REGISTRY_SEPOLIA=
NEXT_PUBLIC_ESCROW_VAULT_SEPOLIA=

NEXT_PUBLIC_POOL_REGISTRY_POLYGON=
NEXT_PUBLIC_ESCROW_VAULT_POLYGON=

# Admin wallet
NEXT_PUBLIC_ADMIN_ADDRESS=

# Contract deployment (server-side only)
DEPLOYER_PRIVATE_KEY=
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# ── 인증/접근제어 (D5/D8) ───────────────────────────────────────────────
# Privy 소셜 로그인 (미설정 시 테스트 계정 모드로 폴백)
NEXT_PUBLIC_PRIVY_APP_ID=

# Supabase — 계정 allowlist 저장소. 둘 다 설정해야 allowlist가 강제됨.
# (미설정 시: 로그인 게이트는 유지되나 allowlist는 미강제 = 개발 모드)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 세션 쿠키 HMAC 서명 키 — 프로덕션 필수 (충분히 긴 랜덤값)
SESSION_SECRET=

# 개발 모드(Supabase 미설정)에서 admin 역할을 부여할 이메일 (선택)
DEV_ADMIN_EMAIL=
